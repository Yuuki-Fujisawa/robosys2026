import sys

minus, zero, plus = 0, 0, 0
x=0.0

for n in sys.stdin[1:]:
    x += float(n)

    if x < 0.0:
        minus += 1
    elif x > 0.0:
        plus += 1
    else:
        zero += 1

print("負:", minus)
print("０:", zero)
print("正:", plus)
